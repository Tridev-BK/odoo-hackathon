generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ActivityCategory {
  FOOD
  CULTURE
  ADVENTURE
  NATURE
  SHOPPING
  NIGHTLIFE
  WELLNESS
  TRANSPORT
  OTHER
}

enum PackingCategory {
  CLOTHING
  DOCUMENTS
  TOILETRIES
  TECH
  HEALTH
  MISC
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]
  notes Note[]

  @@index([createdAt])
  @@map("users")
}

model Trip {
  id            String   @id @default(cuid())
  userId        String
  name          String
  description   String?
  startDate     DateTime
  endDate       DateTime
  coverImageUrl String?
  isPublic      Boolean  @default(false)
  shareSlug     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops        TripStop[]
  activities   TripActivity[]
  packingItems PackingItem[]
  notes        Note[]

  @@index([userId, updatedAt])
  @@index([isPublic, shareSlug])
  @@map("trips")
}

model City {
  id              String   @id @default(cuid())
  name            String
  country         String
  region          String?
  latitude        Decimal? @db.Decimal(9, 6)
  longitude       Decimal? @db.Decimal(9, 6)
  costIndex       Int      @default(50)
  popularityScore Int      @default(50)
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stops      TripStop[]
  activities Activity[]

  @@unique([name, country])
  @@index([country])
  @@index([popularityScore])
  @@map("cities")
}

model TripStop {
  id        String   @id @default(cuid())
  tripId    String
  cityId    String
  startDate DateTime
  endDate   DateTime
  position  Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@index([tripId, position])
  @@index([cityId])
  @@map("trip_stops")
}

model Activity {
  id              String           @id @default(cuid())
  cityId          String
  name            String
  description     String?
  category        ActivityCategory @default(OTHER)
  estimatedCost   Decimal          @default(0) @db.Decimal(10, 2)
  durationMinutes Int              @default(60)
  imageUrl        String?
  popularityScore Int              @default(50)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  city       City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripLinks  TripActivity[]

  @@index([cityId, category])
  @@index([popularityScore])
  @@map("activities")
}

model TripActivity {
  id          String   @id @default(cuid())
  tripId      String
  activityId  String
  scheduledAt DateTime?
  customCost  Decimal? @db.Decimal(10, 2)
  position    Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@index([tripId, scheduledAt])
  @@index([activityId])
  @@map("trip_activities")
}

model PackingItem {
  id        String          @id @default(cuid())
  tripId    String
  label     String
  category  PackingCategory @default(MISC)
  isPacked  Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, category])
  @@index([tripId, isPacked])
  @@map("packing_items")
}

model Note {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  title     String?
  body      String
  dayDate   DateTime?
  reminder  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, dayDate])
  @@index([userId, createdAt])
  @@map("notes")
}
